<script>

/* =====================================================
   GLOBAL VARIABLES
===================================================== */

let currentDocumentText = "";
let allDocuments = [];


/* =====================================================
   ELEMENTS
===================================================== */

const fileInput =
    document.getElementById("fileInput");

const dropZone =
    document.getElementById("dropZone");

const workspace =
    document.getElementById("workspace");

const extractedText =
    document.getElementById("extractedText");

const fileName =
    document.getElementById("fileName");

const charCount =
    document.getElementById("charCount");

const analyzeBtn =
    document.getElementById("analyzeBtn");

const aiResult =
    document.getElementById("aiResult");

const aiContent =
    document.getElementById("aiContent");

const question =
    document.getElementById("question");

const askBtn =
    document.getElementById("askBtn");

const chatArea =
    document.getElementById("chatArea");


/* =====================================================
   OPEN FILE PICKER
===================================================== */

function openFilePicker(){

    fileInput.click();

}


/* =====================================================
   FILE SELECT
===================================================== */

fileInput.addEventListener(
    "change",
    function(){

        if(this.files.length > 0){

            uploadFile(this.files[0]);

        }

    }
);


/* =====================================================
   DROP ZONE CLICK
===================================================== */

dropZone.addEventListener(
    "click",
    function(){

        fileInput.click();

    }
);


/* =====================================================
   DRAG OVER
===================================================== */

dropZone.addEventListener(
    "dragover",
    function(event){

        event.preventDefault();

        dropZone.style.background =
            "#eee9ff";

    }
);


/* =====================================================
   DRAG LEAVE
===================================================== */

dropZone.addEventListener(
    "dragleave",
    function(){

        dropZone.style.background =
            "#f8f5ff";

    }
);


/* =====================================================
   DROP
===================================================== */

dropZone.addEventListener(
    "drop",
    function(event){

        event.preventDefault();

        dropZone.style.background =
            "#f8f5ff";


        if(event.dataTransfer.files.length > 0){

            uploadFile(
                event.dataTransfer.files[0]
            );

        }

    }
);


/* =====================================================
   UPLOAD FILE
===================================================== */

async function uploadFile(file){

    const extensions = [
        ".pdf",
        ".docx",
        ".txt"
    ];


    const valid =
        extensions.some(
            extension =>
                file.name
                    .toLowerCase()
                    .endsWith(extension)
        );


    if(!valid){

        alert(
            "Please select PDF, DOCX or TXT."
        );

        return;

    }


    if(file.size > 20 * 1024 * 1024){

        alert(
            "Maximum file size is 20MB."
        );

        return;

    }


    dropZone.innerHTML = `

        <div class="cloud-icon">
            ↑
        </div>

        <h4>
            Uploading...
        </h4>

        <p>
            DOCVYN is reading your document
        </p>

    `;


    const formData =
        new FormData();


    formData.append(
        "document",
        file
    );


    try{

        const response =
            await fetch(
                "/upload",
                {
                    method:"POST",
                    body:formData
                }
            );


        const result =
            await response.json();


        if(!response.ok || !result.success){

            throw new Error(
                result.message ||
                "Upload failed."
            );

        }


        currentDocumentText =
            result.text || "";


        fileName.textContent =
            result.file.originalName;


        charCount.textContent =
            `${Number(
                result.characters ||
                currentDocumentText.length
            ).toLocaleString()} characters`;


        extractedText.textContent =
            currentDocumentText ||
            "No readable text was found.";


        aiResult.classList.remove(
            "visible"
        );


        aiContent.textContent =
            "";


        clearChat();


        dropZone.innerHTML = `

            <div class="cloud-icon">
                ✓
            </div>

            <h4>
                ${escapeHTML(
                    result.file.originalName
                )}
            </h4>

            <p>
                Document uploaded successfully
            </p>

        `;


        workspace.classList.add(
            "visible"
        );


        /* Refresh document library */

        loadDocuments();


        setTimeout(
            function(){

                workspace.scrollIntoView({
                    behavior:"smooth"
                });

            },
            300
        );

    }
    catch(error){

        console.error(
            "Upload error:",
            error
        );


        alert(
            error.message ||
            "Upload failed."
        );


        resetDropZone();

    }

}


/* =====================================================
   RESET DROP ZONE
===================================================== */

function resetDropZone(){

    dropZone.innerHTML = `

        <div class="cloud-icon">
            ↑
        </div>

        <h4>
            Drop your document here
        </h4>

        <p>
            or
            <span>
                click to browse
            </span>
        </p>

    `;

}


/* =====================================================
   ANALYZE DOCUMENT
===================================================== */

async function analyzeDocument(){

    if(!currentDocumentText.trim()){

        alert(
            "Please upload a document first."
        );

        return;

    }


    analyzeBtn.disabled =
        true;


    analyzeBtn.textContent =
        "🤖 AI is analyzing...";


    aiResult.classList.add(
        "visible"
    );


    aiContent.innerHTML = `

        <div style="
            text-align:center;
            padding:25px;
            color:#7657ef;
            font-weight:700;
        ">

            DOCVYN is analyzing your document...

            <br><br>

            ✦ ✦ ✦

        </div>

    `;


    try{

        const response =
            await fetch(
                "/analyze",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({

                        text:
                            currentDocumentText

                    })

                }
            );


        const result =
            await response.json();


        if(!response.ok || !result.success){

            throw new Error(
                result.message ||
                "AI analysis failed."
            );

        }


        aiContent.textContent =
            result.analysis;

    }
    catch(error){

        console.error(
            "Analysis error:",
            error
        );


        aiContent.textContent =
            "❌ AI analysis failed.\n\n" +
            error.message;

    }


    analyzeBtn.disabled =
        false;


    analyzeBtn.textContent =
        "✨ Analyze Again";

}


/* =====================================================
   ASK DOCUMENT
===================================================== */

async function askDocument(){

    const userQuestion =
        question.value.trim();


    if(!currentDocumentText.trim()){

        alert(
            "Please upload a document first."
        );

        return;

    }


    if(!userQuestion){

        question.focus();

        return;

    }


    const empty =
        document.getElementById(
            "chatEmpty"
        );


    if(empty){

        empty.remove();

    }


    addMessage(
        "user",
        userQuestion
    );


    question.value =
        "";


    askBtn.disabled =
        true;


    askBtn.textContent =
        "•••";


    const loadingMessage =
        addMessage(
            "ai",
            "DOCVYN is thinking..."
        );


    try{

        const response =
            await fetch(
                "/ask",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({

                        text:
                            currentDocumentText,

                        question:
                            userQuestion

                    })

                }
            );


        const result =
            await response.json();


        if(!response.ok || !result.success){

            throw new Error(
                result.message ||
                "Unable to answer."
            );

        }


        loadingMessage
            .querySelector(
                ".message-bubble"
            )
            .textContent =
                result.answer;

    }
    catch(error){

        console.error(
            "Ask error:",
            error
        );


        loadingMessage
            .querySelector(
                ".message-bubble"
            )
            .textContent =
                "❌ Unable to answer.\n\n" +
                error.message;

    }


    askBtn.disabled =
        false;


    askBtn.textContent =
        "↑";


    chatArea.scrollTop =
        chatArea.scrollHeight;

}


/* =====================================================
   ADD MESSAGE
===================================================== */

function addMessage(type,text){

    const message =
        document.createElement(
            "div"
        );


    message.className =
        `message ${type}`;


    const avatar =
        document.createElement(
            "div"
        );


    avatar.className =
        "message-avatar";


    avatar.textContent =
        type === "user"
            ? "👤"
            : "✦";


    const content =
        document.createElement(
            "div"
        );


    content.className =
        "message-content";


    const name =
        document.createElement(
            "div"
        );


    name.className =
        "message-name";


    name.textContent =
        type === "user"
            ? "You"
            : "DOCVYN";


    const bubble =
        document.createElement(
            "div"
        );


    bubble.className =
        "message-bubble";


    bubble.textContent =
        text;


    content.appendChild(
        name
    );


    content.appendChild(
        bubble
    );


    message.appendChild(
        avatar
    );


    message.appendChild(
        content
    );


    chatArea.appendChild(
        message
    );


    chatArea.scrollTop =
        chatArea.scrollHeight;


    return message;

}


/* =====================================================
   ENTER TO SEND
===================================================== */

question.addEventListener(
    "keydown",
    function(event){

        if(
            event.key === "Enter" &&
            !event.shiftKey
        ){

            event.preventDefault();

            askDocument();

        }

    }
);


/* =====================================================
   CLEAR CHAT
===================================================== */

function clearChat(){

    chatArea.innerHTML = `

        <div
            class="chat-empty"
            id="chatEmpty">

            <div class="chat-empty-icon">
                💡
            </div>

            Ask your first question about this document.

            <br><br>

            Try:

            <strong>
                "What is the main purpose of this document?"
            </strong>

        </div>

    `;

}


/* =====================================================
   CLEAR DOCUMENT
===================================================== */

function clearDocument(){

    currentDocumentText =
        "";


    fileInput.value =
        "";


    workspace.classList.remove(
        "visible"
    );


    aiResult.classList.remove(
        "visible"
    );


    aiContent.textContent =
        "";


    extractedText.textContent =
        "Your extracted text will appear here.";


    fileName.textContent =
        "Document";


    charCount.textContent =
        "0 characters";


    analyzeBtn.disabled =
        false;


    analyzeBtn.textContent =
        "✨ Analyze with AI";


    clearChat();


    resetDropZone();


    window.scrollTo({

        top:0,

        behavior:"smooth"

    });

}


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHTML(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* =====================================================
   LOAD DOCUMENTS
===================================================== */

async function loadDocuments(){

    const container =
        document.getElementById(
            "documentsContainer"
        );


    const count =
        document.getElementById(
            "documentCount"
        );


    container.innerHTML = `

        <div class="loading-documents">

            <div class="loading-icon">
                📂
            </div>

            Loading documents...

        </div>

    `;


    try{

        const response =
            await fetch(
                "/documents"
            );


        const data =
            await response.json();


        console.log(
            "GET /documents:",
            data
        );


        if(!response.ok || !data.success){

            throw new Error(
                data.message ||
                "Could not load documents."
            );

        }


        allDocuments =
            Array.isArray(
                data.documents
            )
                ? data.documents
                : [];


        createCategoryFilter();


        displayDocuments(
            allDocuments
        );

    }
    catch(error){

        console.error(
            "Load documents error:",
            error
        );


        container.innerHTML = `

            <div class="empty-documents">

                <div style="font-size:40px;">
                    ⚠️
                </div>

                <h3>
                    Unable to load documents
                </h3>

                <p>
                    ${escapeHTML(
                        error.message
                    )}
                </p>

            </div>

        `;


        count.textContent =
            "Could not load documents.";

    }

}


/* =====================================================
   CREATE CATEGORY FILTER
===================================================== */

function createCategoryFilter(){

    const filter =
        document.getElementById(
            "categoryFilter"
        );


    const currentValue =
        filter.value;


    const categories = [

        ...new Set(

            allDocuments.map(

                doc =>
                    doc.category ||
                    getCategoryFromType(
                        doc.fileType
                    )

            )

        )

    ].sort();


    filter.innerHTML = `

        <option value="all">
            All Categories
        </option>

        ${
            categories.map(
                category => `

                    <option
                        value="${escapeHTML(
                            category
                        )}">

                        ${escapeHTML(
                            category
                        )}

                    </option>

                `
            ).join("")
        }

    `;


    if(
        categories.includes(
            currentValue
        )
    ){

        filter.value =
            currentValue;

    }

}


/* =====================================================
   GET CATEGORY
===================================================== */

function getCategoryFromType(fileType){

    const type =
        String(
            fileType || ""
        ).toLowerCase();


    if(type.includes("pdf")){

        return "PDF Documents";

    }


    if(type.includes("doc")){

        return "Word Documents";

    }


    if(type.includes("txt")){

        return "Text Documents";

    }


    return "Other";

}


/* =====================================================
   FILTER DOCUMENTS
===================================================== */

function filterDocuments(){

    const search =
        document
            .getElementById(
                "documentSearch"
            )
            .value
            .toLowerCase()
            .trim();


    const category =
        document
            .getElementById(
                "categoryFilter"
            )
            .value;


    const filtered =
        allDocuments.filter(
            doc => {

                const name =
                    String(
                        doc.fileName || ""
                    ).toLowerCase();


                const docCategory =
                    doc.category ||
                    getCategoryFromType(
                        doc.fileType
                    );


                const matchesSearch =
                    name.includes(
                        search
                    );


                const matchesCategory =
                    category === "all" ||
                    docCategory === category;


                return (
                    matchesSearch &&
                    matchesCategory
                );

            }
        );


    displayDocuments(
        filtered
    );

}


/* =====================================================
   DISPLAY DOCUMENTS
===================================================== */

function displayDocuments(documents){

    const container =
        document.getElementById(
            "documentsContainer"
        );


    const count =
        document.getElementById(
            "documentCount"
        );


    const sorted =
        [...documents].sort(
            (a,b) =>
                new Date(
                    b.uploadedAt
                ) -
                new Date(
                    a.uploadedAt
                )
        );


    count.textContent =
        `${sorted.length} document${
            sorted.length !== 1
                ? "s"
                : ""
        }`;


    if(!sorted.length){

        container.innerHTML = `

            <div class="empty-documents">

                <div style="font-size:42px;">
                    🔍
                </div>

                <h3>
                    No documents found
                </h3>

                <p>
                    Try another search or category.
                </p>

            </div>

        `;

        return;

    }


    container.innerHTML =
        sorted.map(
            doc => {

                const size =
                    (
                        Number(
                            doc.fileSize || 0
                        ) / 1024
                    ).toFixed(1);


                const date =
                    new Date(
                        doc.uploadedAt
                    ).toLocaleDateString(
                        "en-IN",
                        {
                            day:"2-digit",
                            month:"short",
                            year:"numeric"
                        }
                    );


                const category =
                    doc.category ||
                    getCategoryFromType(
                        doc.fileType
                    );


                const icon =
                    getDocumentIcon(
                        doc.fileType
                    );


                return `

                    <div class="document-card">

                        <div class="document-card-icon">

                            ${icon}

                        </div>


                        <div class="document-category">

                            ${escapeHTML(
                                category
                            )}

                        </div>


                        <div class="document-card-name">

                            ${escapeHTML(
                                doc.fileName ||
                                "Untitled Document"
                            )}

                        </div>


                        <div class="document-card-info">

                            ${escapeHTML(
                                String(
                                    doc.fileType || ""
                                ).toUpperCase()
                            )}

                            &nbsp; • &nbsp;

                            ${size} KB

                            <br>

                            Uploaded:
                            ${date}

                        </div>


                        <div class="document-actions">

                            <button
                                class="open-document"
                                onclick="openDocument('${escapeHTML(
                                    doc._id
                                )}')">

                                📂 Open

                            </button>


                            <button
                                class="delete-document"
                                onclick="deleteDocument('${escapeHTML(
                                    doc._id
                                )}')">

                                🗑 Delete

                            </button>

                        </div>

                    </div>

                `;

            }
        ).join("");

}


/* =====================================================
   DOCUMENT ICON
===================================================== */

function getDocumentIcon(fileType){

    const type =
        String(
            fileType || ""
        ).toLowerCase();


    if(type.includes("pdf"))
        return "📕";


    if(type.includes("doc"))
        return "📘";


    if(type.includes("txt"))
        return "📄";


    return "📁";

}


/* =====================================================
   OPEN DOCUMENT
===================================================== */

async function openDocument(id){

    console.log(
        "📂 Open clicked:",
        id
    );


    try{

        const response =
            await fetch(
                `/documents/${id}`
            );


        const data =
            await response.json();


        console.log(
            "Open response:",
            data
        );


        if(
            !response.ok ||
            !data.success
        ){

            throw new Error(
                data.message ||
                "Document could not be opened."
            );

        }


        const doc =
            data.document;


        currentDocumentText =
            doc.text ||
            doc.extractedText ||
            doc.content ||
            "";


        fileName.textContent =
            doc.fileName ||
            "Document";


        charCount.textContent =
            `${currentDocumentText.length.toLocaleString()} characters`;


        extractedText.textContent =
            currentDocumentText ||
            "No readable text was found.";


        aiResult.classList.remove(
            "visible"
        );


        aiContent.textContent =
            "";


        analyzeBtn.disabled =
            false;


        analyzeBtn.textContent =
            "✨ Analyze with AI";


        clearChat();


        workspace.classList.add(
            "visible"
        );


        setTimeout(
            function(){

                workspace.scrollIntoView({
                    behavior:"smooth"
                });

            },
            200
        );

    }
    catch(error){

        console.error(
            "Open document error:",
            error
        );


        alert(
            "❌ Could not open document:\n" +
            error.message
        );

    }

}


/* =====================================================
   DELETE DOCUMENT
===================================================== */

async function deleteDocument(id){

    console.log(
        "🗑 DELETE CLICKED:",
        id
    );


    const confirmed =
        confirm(
            "Are you sure you want to delete this document?"
        );


    if(!confirmed){

        console.log(
            "Delete cancelled"
        );

        return;

    }


    try{

        const response =
            await fetch(
                `/documents/${id}`,
                {
                    method:"DELETE"
                }
            );


        console.log(
            "DELETE STATUS:",
            response.status
        );


        const data =
            await response.json();


        console.log(
            "DELETE RESPONSE:",
            data
        );


        if(
            !response.ok ||
            !data.success
        ){

            throw new Error(
                data.message ||
                `Delete failed (${response.status})`
            );

        }


        alert(
            "✅ Document deleted successfully!"
        );


        await loadDocuments();

    }
    catch(error){

        console.error(
            "❌ DELETE ERROR:",
            error
        );


        alert(
            "❌ Delete failed:\n" +
            error.message
        );

    }

}


/* =====================================================
   INITIAL LOAD
===================================================== */

loadDocuments();

</script>


