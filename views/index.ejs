<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>DOCVYN | AI Document Assistant</title>

<style>

/* =====================================================
   RESET
===================================================== */

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#fffbea;
    color:#1d1b3f;
}


/* =====================================================
   NAVBAR
===================================================== */

.navbar{
    height:72px;
    padding:0 7%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:rgba(255,255,255,.96);
    border-bottom:1px solid #eee5d0;
    position:sticky;
    top:0;
    z-index:100;
}

.brand{
    display:flex;
    align-items:center;
    gap:10px;
}

.brand-icon{
    width:39px;
    height:39px;
    border-radius:12px;
    background:linear-gradient(135deg,#7654ff,#a35aff);
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:20px;
}

.brand h2{
    font-size:20px;
}

.brand h2 span{
    color:#8058ef;
}

.brand small{
    display:block;
    color:#9691a7;
    font-size:8px;
    margin-top:2px;
}

.nav-links{
    display:flex;
    gap:30px;
}

.nav-links a{
    text-decoration:none;
    color:#5e5b73;
    font-size:13px;
    font-weight:600;
}

.nav-links a:hover{
    color:#7654ef;
}

.login-btn{
    padding:10px 19px;
    border-radius:9px;
    border:1px solid #ded7ef;
    background:white;
    color:#7052d5;
    font-weight:700;
    cursor:pointer;
}


/* =====================================================
   HERO
===================================================== */

.hero{
    min-height:650px;
    padding:70px 7%;
    display:grid;
    grid-template-columns:1.05fr .8fr .95fr;
    align-items:center;
    gap:30px;
    background:
        radial-gradient(circle at 4% 5%,#fff0bd 0,transparent 150px),
        linear-gradient(135deg,#fffdf2,#fff2d8);
}

.hero-left{
    z-index:2;
}

.badge{
    display:inline-block;
    padding:8px 14px;
    border-radius:20px;
    background:#eee9ff;
    color:#7653db;
    font-size:11px;
    font-weight:700;
    margin-bottom:22px;
}

.hero h1{
    font-size:57px;
    line-height:1.05;
    letter-spacing:-2px;
}

.hero h1 span{
    color:#e85aa9;
    display:block;
}

.hero h1 span::after{
    content:"";
    display:block;
    width:140px;
    height:5px;
    background:#9259f4;
    border-radius:10px;
    margin-top:7px;
    transform:rotate(-2deg);
}

.hero-left>p{
    margin-top:25px;
    max-width:480px;
    color:#605d77;
    line-height:1.8;
    font-size:15px;
}

.hero-left>p strong{
    display:block;
    margin-top:8px;
    color:#484562;
}

.hero-buttons{
    display:flex;
    gap:12px;
    margin-top:30px;
}

.primary-btn{
    border:none;
    padding:15px 23px;
    border-radius:11px;
    background:linear-gradient(135deg,#7654ff,#a35aff);
    color:white;
    font-weight:700;
    cursor:pointer;
    box-shadow:0 12px 25px rgba(118,84,255,.22);
}

.secondary-btn{
    padding:14px 22px;
    border-radius:11px;
    border:1px solid #dcd5ec;
    background:white;
    color:#675791;
    font-weight:700;
    cursor:pointer;
}

.trusted{
    display:flex;
    gap:22px;
    margin-top:27px;
    color:#77728d;
    font-size:12px;
}


/* =====================================================
   ROBOT
===================================================== */

.hero-visual{
    height:430px;
    position:relative;
    display:flex;
    justify-content:center;
    align-items:center;
}

.robot{
    position:relative;
    width:190px;
    height:250px;
    margin-top:40px;
}

.antenna{
    position:absolute;
    width:7px;
    height:48px;
    background:#a28aff;
    top:-42px;
    left:92px;
    border-radius:10px;
}

.antenna::after{
    content:"";
    position:absolute;
    width:17px;
    height:17px;
    border-radius:50%;
    background:#7955ed;
    left:-5px;
    top:-6px;
}

.robot-head{
    width:160px;
    height:120px;
    background:#1c1a48;
    border:7px solid #c8baff;
    border-radius:55px;
    margin:auto;
    position:relative;
}

.robot-eye{
    position:absolute;
    width:13px;
    height:18px;
    border-radius:50%;
    background:#61def5;
    top:40px;
}

.left-eye{
    left:42px;
}

.right-eye{
    right:42px;
}

.robot-smile{
    position:absolute;
    bottom:17px;
    left:68px;
    color:#ff65b4;
    font-size:23px;
}

.robot-body{
    width:115px;
    height:105px;
    background:#f4efff;
    border:5px solid #c8baff;
    border-radius:30px;
    margin:-2px auto;
    display:flex;
    align-items:center;
    justify-content:center;
}

.robot-screen{
    padding:10px 13px;
    background:#7654e8;
    color:white;
    border-radius:10px;
    font-size:12px;
    font-weight:800;
}

.folder{
    position:absolute;
    left:18px;
    bottom:45px;
    width:95px;
    height:65px;
    background:#ffc85b;
    border-radius:9px;
    transform:rotate(-7deg);
}

.folder-tab{
    width:43px;
    height:12px;
    background:#f7b943;
    position:absolute;
    top:-8px;
    left:12px;
    border-radius:7px 7px 0 0;
}

.folder-body{
    text-align:center;
    padding-top:25px;
    font-size:23px;
}

.document-paper{
    position:absolute;
    right:5px;
    bottom:22px;
    width:105px;
    height:145px;
    background:white;
    border-radius:8px;
    padding:16px;
    transform:rotate(8deg);
    box-shadow:0 12px 25px rgba(50,40,90,.12);
}

.paper-top{
    display:flex;
    justify-content:space-between;
    color:#7655dd;
    font-weight:800;
    font-size:10px;
}

.paper-line{
    height:5px;
    background:#e6e0f5;
    margin-top:11px;
    border-radius:5px;
}

.paper-line.large{
    width:80%;
}

.paper-line.short{
    width:55%;
}


/* =====================================================
   UPLOAD CARD
===================================================== */

.upload-card{
    background:rgba(255,255,255,.96);
    border:1px solid #eadfc5;
    border-radius:23px;
    padding:27px;
    box-shadow:0 20px 45px rgba(80,60,110,.09);
}

.upload-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:22px;
}

.upload-header h3{
    font-size:17px;
}

.upload-header p{
    color:#25a46b;
    font-size:11px;
    font-weight:700;
    margin-top:7px;
}

.upload-check{
    width:34px;
    height:34px;
    border-radius:50%;
    background:#e5f8ef;
    color:#27a96e;
    display:flex;
    justify-content:center;
    align-items:center;
}

.drop-zone{
    min-height:210px;
    border:2px dashed #8060ff;
    border-radius:17px;
    background:#f8f5ff;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    cursor:pointer;
}

.cloud-icon{
    width:58px;
    height:58px;
    border-radius:15px;
    background:linear-gradient(135deg,#7652f5,#9b5cff);
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:30px;
    margin-bottom:13px;
}

.drop-zone h4{
    font-size:14px;
    max-width:90%;
    word-break:break-word;
}

.drop-zone p{
    color:#9995aa;
    font-size:11px;
    margin-top:8px;
}

.drop-zone p span{
    color:#7655e2;
    font-weight:700;
}

.file-support{
    display:flex;
    justify-content:center;
    gap:8px;
    margin-top:18px;
}

.file-support span{
    background:#f0ecff;
    color:#7053d5;
    padding:5px 9px;
    border-radius:6px;
    font-size:9px;
    font-weight:700;
}

.upload-card>small{
    display:block;
    text-align:center;
    margin-top:14px;
    color:#aaa5b4;
    font-size:9px;
}


/* =====================================================
   WORKSPACE
===================================================== */

#workspace{
    display:none;
    padding:75px 7%;
    background:#fffbea;
}

#workspace.visible{
    display:block;
}

.workspace-title{
    text-align:center;
    margin-bottom:35px;
}

.workspace-title p{
    color:#7657ef;
    font-size:11px;
    font-weight:800;
    letter-spacing:2px;
    margin-bottom:10px;
}

.workspace-title h2{
    font-size:37px;
}

.workspace-title h2 span{
    color:#e95da9;
}


/* =====================================================
   DOCUMENT INFO
===================================================== */

.document-info{
    max-width:1000px;
    margin:auto auto 20px;
    padding:18px 22px;
    background:white;
    border:1px solid #eee4ca;
    border-radius:17px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.document-name{
    display:flex;
    align-items:center;
    gap:12px;
}

.document-icon{
    width:42px;
    height:42px;
    border-radius:11px;
    background:#eee9ff;
    display:flex;
    align-items:center;
    justify-content:center;
}

.document-name h4{
    font-size:13px;
    word-break:break-word;
}

.document-name p{
    color:#9994a7;
    font-size:10px;
    margin-top:4px;
}

.stats{
    display:flex;
    gap:8px;
}

.stat{
    background:#f2eeff;
    color:#6c53ce;
    padding:8px 11px;
    border-radius:8px;
    font-size:10px;
    font-weight:700;
}


/* =====================================================
   TEXT CARD
===================================================== */

.text-card{
    max-width:1000px;
    margin:auto;
    background:white;
    border:1px solid #e9e1ca;
    border-radius:19px;
    overflow:hidden;
    box-shadow:0 15px 35px rgba(70,50,100,.06);
}

.card-heading{
    padding:18px 22px;
    border-bottom:1px solid #eee8da;
    display:flex;
    justify-content:space-between;
}

.card-heading h3{
    font-size:15px;
}

.ready{
    color:#25a36a;
    font-size:10px;
    font-weight:800;
}

#extractedText{
    min-height:220px;
    max-height:400px;
    overflow-y:auto;
    padding:24px;
    white-space:pre-wrap;
    line-height:1.8;
    color:#5e5c74;
    font-size:13px;
    background:#fffdf7;
}


/* =====================================================
   ACTION BUTTONS
===================================================== */

.actions{
    max-width:1000px;
    margin:22px auto;
    display:flex;
    justify-content:center;
    gap:12px;
}

.analyze-btn{
    border:none;
    padding:14px 25px;
    border-radius:11px;
    background:linear-gradient(135deg,#7653ff,#a25aff);
    color:white;
    font-weight:700;
    cursor:pointer;
}

.clear-btn{
    border:1px solid #ddd5ee;
    background:white;
    color:#665791;
    padding:14px 23px;
    border-radius:11px;
    font-weight:700;
    cursor:pointer;
}


/* =====================================================
   AI RESULT
===================================================== */

.ai-result{
    max-width:1000px;
    margin:25px auto;
    background:white;
    border:1px solid #ddd4ff;
    border-radius:19px;
    overflow:hidden;
    display:none;
}

.ai-result.visible{
    display:block;
}

.ai-header{
    padding:20px 24px;
    background:#f7f3ff;
    border-bottom:1px solid #e4dcff;
}

.ai-header h3{
    color:#694ed4;
    font-size:17px;
}

.ai-header p{
    color:#9993a8;
    font-size:10px;
    margin-top:5px;
}

#aiContent{
    padding:25px;
    white-space:pre-wrap;
    line-height:1.8;
    color:#55546d;
    font-size:13px;
}


/* =====================================================
   ASK DOCUMENT
===================================================== */

.ask-document{
    max-width:1000px;
    margin:38px auto 0;
    background:#ffffff;
    border:1px solid #dcd2f2;
    border-radius:24px;
    overflow:hidden;
    box-shadow:0 20px 50px rgba(72,55,120,.10);
}

.ask-header{
    padding:24px 28px;
    background:linear-gradient(135deg,#f6f1ff,#fff1f8);
    border-bottom:1px solid #e5dcf2;
}

.ask-header-row{
    display:flex;
    align-items:center;
    gap:15px;
}

.ask-icon{
    width:48px;
    height:48px;
    border-radius:15px;
    background:linear-gradient(135deg,#7552ff,#e65ba9);
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:21px;
}

.ask-header h3{
    color:#55419d;
    font-size:20px;
}

.ask-header p{
    color:#8c879b;
    font-size:12px;
    margin-top:5px;
}

.chat-area{
    min-height:150px;
    max-height:460px;
    overflow-y:auto;
    padding:28px;
    background:linear-gradient(180deg,#fffefa,#fffdf8);
}

.chat-area::-webkit-scrollbar{
    width:7px;
}

.chat-area::-webkit-scrollbar-track{
    background:#faf7ef;
}

.chat-area::-webkit-scrollbar-thumb{
    background:#d8cdf3;
    border-radius:20px;
}

.chat-empty{
    text-align:center;
    padding:35px 20px;
    color:#aaa5b4;
    font-size:12px;
}

.chat-empty-icon{
    width:50px;
    height:50px;
    border-radius:15px;
    background:#f1ecff;
    color:#7654e5;
    display:flex;
    align-items:center;
    justify-content:center;
    margin:0 auto 13px;
    font-size:23px;
}

.message{
    display:flex;
    gap:12px;
    margin-bottom:25px;
    animation:messageIn .3s ease;
}

@keyframes messageIn{

    from{
        opacity:0;
        transform:translateY(10px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

.message.user{
    flex-direction:row-reverse;
}

.message-avatar{
    min-width:39px;
    height:39px;
    border-radius:13px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:15px;
    font-weight:800;
    border:1px solid;
}

.message.ai .message-avatar{
    background:#f0ebff;
    border-color:#dcd1ff;
    color:#7051dc;
}

.message.user .message-avatar{
    background:#ffeaf5;
    border-color:#ffd2e7;
    color:#d84d93;
}

.message-content{
    max-width:76%;
}

.message-name{
    font-size:10px;
    color:#9993a8;
    font-weight:700;
    margin-bottom:6px;
    padding-left:3px;
}

.message.user .message-name{
    text-align:right;
    padding-right:3px;
}

.message-bubble{
    position:relative;
    padding:14px 17px;
    font-size:13px;
    line-height:1.75;
    white-space:pre-wrap;
    border-radius:17px;
}

.message.ai .message-bubble{
    background:linear-gradient(135deg,#f6f2ff,#eee8ff);
    color:#4f4b67;
    border:1px solid #dcd2ff;
    border-top-left-radius:5px;
    box-shadow:0 7px 20px rgba(92,69,160,.08);
}

.message.user .message-bubble{
    background:linear-gradient(135deg,#7654ff,#9857ee);
    color:white;
    border:1px solid #704ce9;
    border-top-right-radius:5px;
    box-shadow:0 8px 20px rgba(118,84,255,.20);
}

.ask-input-area{
    padding:20px 25px 22px;
    border-top:1px solid #eee8dd;
    background:white;
}

.input-wrapper{
    display:flex;
    align-items:flex-end;
    gap:10px;
    border:1px solid #d7cdef;
    border-radius:17px;
    padding:8px;
    background:#fffdfa;
}

.input-wrapper:focus-within{
    border-color:#7958ed;
    box-shadow:0 0 0 4px rgba(121,88,237,.09);
}

#question{
    flex:1;
    min-height:48px;
    max-height:130px;
    resize:none;
    border:none;
    outline:none;
    background:transparent;
    padding:10px;
    font-family:Arial,sans-serif;
    font-size:13px;
    color:#55546d;
}

#question::placeholder{
    color:#aaa6b5;
}

#askBtn{
    width:45px;
    height:45px;
    border:none;
    border-radius:13px;
    background:linear-gradient(135deg,#7654ff,#e25baa);
    color:white;
    font-size:18px;
    cursor:pointer;
    flex-shrink:0;
}

#askBtn:disabled{
    opacity:.55;
    cursor:not-allowed;
}

.input-bottom{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-top:10px;
}

.ask-hint{
    color:#aaa5b4;
    font-size:10px;
}

.clear-chat{
    border:none;
    background:transparent;
    color:#8a82a0;
    font-size:10px;
    cursor:pointer;
    font-weight:700;
}


/* =====================================================
   FEATURES
===================================================== */

.features{
    padding:80px 7%;
    background:#fffbea;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title p{
    color:#7655e4;
    font-size:11px;
    letter-spacing:2px;
    font-weight:800;
    margin-bottom:10px;
}

.section-title h2{
    font-size:35px;
}

.section-title h2 span{
    color:#7654e2;
}

.feature-grid{
    max-width:1100px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.feature-card{
    padding:25px;
    border-radius:17px;
    min-height:190px;
    border:1px solid #e8dfd0;
}

.feature-card:nth-child(1){
    background:#f4efff;
}

.feature-card:nth-child(2){
    background:#fff0f7;
}

.feature-card:nth-child(3){
    background:#eef6ff;
}

.feature-card:nth-child(4){
    background:#fff8df;
}

.feature-icon{
    width:43px;
    height:43px;
    border-radius:12px;
    background:white;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:20px;
    margin-bottom:20px;
}

.feature-card h3{
    font-size:15px;
    margin-bottom:10px;
}

.feature-card p{
    color:#77738a;
    font-size:12px;
    line-height:1.7;
}


/* =====================================================
   HOW IT WORKS
===================================================== */

.how{
    padding:80px 7%;
    background:#fffdf4;
}

.steps{
    max-width:1000px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:25px;
}

.step{
    text-align:center;
}

.step-number{
    width:45px;
    height:45px;
    border-radius:50%;
    margin:auto auto 17px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#ece6ff;
    color:#7155db;
    font-size:11px;
    font-weight:800;
}

.step-icon{
    font-size:28px;
    margin-bottom:10px;
}

.step h3{
    font-size:15px;
    margin-bottom:8px;
}

.step p{
    color:#858096;
    font-size:11px;
    line-height:1.6;
}


/* =====================================================
   DOCUMENT LIBRARY
===================================================== */

.document-library{
    max-width:1100px;
    margin:0 auto;
    padding:80px 30px;
}

.library-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:30px;
}

.library-label{
    color:#7655e4;
    font-size:11px;
    font-weight:800;
    letter-spacing:2px;
    margin-bottom:7px;
}

.library-header h2{
    font-size:32px;
    color:#1d1b3f;
}

.library-header p:last-child{
    margin-top:7px;
    color:#858096;
    font-size:13px;
}

.refresh-btn{
    border:1px solid #ddd5ee;
    background:white;
    color:#6954a0;
    padding:11px 18px;
    border-radius:11px;
    cursor:pointer;
    font-weight:700;
}

.library-controls{
    display:flex;
    gap:14px;
    margin-bottom:18px;
}

.search-box{
    flex:1;
    display:flex;
    align-items:center;
    gap:10px;
    background:white;
    border:1px solid #ddd5ee;
    border-radius:13px;
    padding:4px 15px;
}

.search-box:focus-within{
    border-color:#7958ed;
    box-shadow:0 0 0 4px rgba(121,88,237,.08);
}

.search-box span{
    font-size:17px;
}

.search-box input{
    width:100%;
    border:none;
    outline:none;
    background:transparent;
    padding:12px 5px;
    font-size:13px;
    color:#4e4a66;
}

.filter-box{
    display:flex;
    align-items:center;
